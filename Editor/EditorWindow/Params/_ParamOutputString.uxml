<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.atlas.workflow/Editor/EditorWindow/Styles/_ParamStyles.uss?fileID=7433441132597879392&amp;guid=137bd3f6517b35648a6975ef73eb63d3&amp;type=3#_ParamStyles" />
    <ui:VisualElement class="param-row-complex string-param-row">
        <ui:VisualElement class="param-row-header string-param-header">
            <ui:VisualElement name="type-indicator" class="type-indicator" />
            <ui:Label name="label" text="Parameter Label" class="param-label" />
        </ui:VisualElement>
        <ui:VisualElement class="readonly-text-body">
            <ui:TextField name="value-field" class="param-value output-readonly-text" style="white-space: normal;" />
            <ui:Button name="copy-button" text="Copy" class="output-copy-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
