<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.atlas.workflow/Editor/EditorWindow/Styles/AtlasWorkflowEditor.uss?fileID=7433441132597879392&amp;guid=f7fba480d79272445a15f031bc6895be&amp;type=3#AtlasWorkflowEditor" />
    <Style src="project://database/Packages/com.atlas.workflow/Editor/EditorWindow/Styles/_ParamStyles.uss?fileID=7433441132597879392&amp;guid=137bd3f6517b35648a6975ef73eb63d3&amp;type=3#_ParamStyles" />
    <Style src="project://database/Packages/com.atlas.workflow/Editor/EditorWindow/Styles/_WorkflowJobView.uss?fileID=7433441132597879392&amp;guid=651450396d11c3f4bb26a4a9c5541b56&amp;type=3#_WorkflowJobView" />
    <ui:VisualElement name="main-container" style="flex-grow: 1; flex-direction: column;">
        <ui:VisualElement name="running-jobs-panel" class="section-box primary-panel" style="flex-shrink: 0;">
            <ui:VisualElement class="panel-header">
                <ui:Label text="Running Jobs" class="panel-header__title primary-panel__title" />
            </ui:VisualElement>
            <ui:ScrollView name="running-jobs-list" />
        </ui:VisualElement>
        <ui:VisualElement name="jobs-panel" class="section-box primary-panel" style="flex-grow: 1; flex-direction: column; overflow: hidden; padding: 0;">
            <ui:VisualElement class="panel-header" style="flex-shrink: 0;">
                <ui:Label text="Jobs History" class="panel-header__title primary-panel__title" />
                <ui:VisualElement style="flex-grow: 1;" />
                <ui:Button name="jobs-menu-btn" text="⋮" class="panel-menu-btn" tooltip="Options" />
            </ui:VisualElement>
            <ui:VisualElement class="panel-body" style="flex-grow: 1; overflow: hidden;">
                <ui:ScrollView name="jobs-list" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
